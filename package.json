{
  "name": "install-a-program",
  "private": true,
  "version": "0.1.5",
  "description": "Install a Program (Bulk Edition) — install multiple programs at once on Windows (Ninite-style bulk install) with Chocolatey, winget, updates, and classic uninstall",
  "keywords": [
    "install-a-program",
    "install-multiple-programs",
    "ninite-alternative",
    "bulk-install-software",
    "install-programs-windows",
    "silent-install",
    "software-bundle-installer",
    "chocolatey-gui",
    "winget-gui",
    "windows-package-manager",
    "package-manager-gui",
    "scoop-gui",
    "bulk-update",
    "outdated-packages",
    "uninstall-programs",
    "windows-11",
    "tauri"
  ],
  "author": {
    "name": "Taylor Ivanoff"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-tauri.cjs dev",
    "start": "node scripts/run-tauri.cjs dev",
    "build": "node scripts/run-tauri.cjs build",
    "build:portable": "node scripts/run-tauri.cjs build --no-bundle",
    "build:runner": "cargo build --release --manifest-path src-tauri/Cargo.toml --bin install-a-program-runner",
    "tauri": "node scripts/run-tauri.cjs",
    "release": "npm run build:runner && node scripts/run-tauri.cjs build",
    "bump": "node scripts/bump-version.cjs",
    "icon": "node scripts/run-tauri.cjs icon app-icon.png",
    "postinstall": "node scripts/sync-shared-styles.cjs",
    "sync:styles": "node scripts/sync-shared-styles.cjs",
    "predev": "node scripts/sync-shared-styles.cjs",
    "prebuild": "node scripts/sync-shared-styles.cjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@taylorivanoff/shared-styles": "file:../shared-styles"
  }
}
