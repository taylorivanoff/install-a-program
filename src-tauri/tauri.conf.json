{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Install Many Programs",
  "version": "0.1.5",
  "identifier": "io.github.taylorivanoff.install-a-program",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Install Many Programs",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Taylor Ivanoff",
    "shortDescription": "Install multiple programs at once (Ninite-style bulk install)",
    "longDescription": "Install Many Programs is a Ninite-style bulk software installer and Chocolatey GUI / winget GUI alternative for Windows. Search and install many packages at once via Chocolatey and winget, bulk-update outdated apps, manage sources, bootstrap Chocolatey when missing, and uninstall classic Win32/MSI programs from the registry.",
    "category": "Utility",
    "copyright": "Copyright © Taylor Ivanoff",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "perMachine",
        "template": "./windows/installer.nsi",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyRjMzMEMzREEzQjJBMzIKUldReUtqdmF3ekR6d2taaHVETjd3MFA4SFpJMHRieG1WRG5sZHU5aWsrSkJXUFRJSTk4VlFoanIK",
      "endpoints": [
        "https://github.com/taylorivanoff/install-a-program/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
